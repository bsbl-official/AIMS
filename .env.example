# Development template only. Production uses the prod Spring profile and
# secret-file variables supplied by the deployment platform.
SPRING_PROFILES_ACTIVE=dev
DB_NAME=account_bm
DB_URL=jdbc:postgresql://localhost:5432/account_bm
DB_USERNAME=account_bm
DB_PASSWORD=
BACKEND_PORT=8080
FRONTEND_PORT=5173
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
JWT_ISSUER=account-bm-api
JWT_SECRET=
JWT_AUDIENCE=account-bm-web
MFA_ENCRYPTION_KEY=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Strict
BOOTSTRAP_ADMIN_ENABLED=true
SUPER_ADMIN_EMAIL=replace-with-initial-admin@example.invalid
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Initial Administrator
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# S3-compatible private attachment storage.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=account-bm-private
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PATH_STYLE=true
